# Waitlist and Lab-inquiry storage (Supabase). Apply supabase/migrations/* in order.
# Public by design (baked into the static site); the key can only call join_waitlist
# and submit_lab_inquiry.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Checkout: a Stripe Payment Link (https://buy.stripe.com/...). Public by design.
# The build fails without it so the pre-order button can never point nowhere.
# Use a test-mode link (buy.stripe.com/test_...) locally; the live link goes in Vercel's production env.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
