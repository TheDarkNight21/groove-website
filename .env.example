# Waitlist and Lab-inquiry storage (Supabase). Apply supabase/migrations/* in order.
# Public by design (baked into the static pages); the key can only call join_waitlist
# and submit_lab_inquiry.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key for the /preorder checkout (pk_test_… locally and in Preview,
# pk_live_… only in Production). Public by design: Stripe.js needs it in the browser.
# Must be the same mode and account as STRIPE_SECRET_KEY, or /preorder says checkout
# is unavailable instead of showing a form that can't pay.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Orders (server only; never NEXT_PUBLIC_) ----
# Stripe: sk_test_… locally and in Preview, sk_live_… only in Production.
# The admin shows orders of the key's mode only, so test orders never reach a live export.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook/ (or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Same project as NEXT_PUBLIC_SUPABASE_URL in production; locally `supabase start` (http://127.0.0.1:55321).
SUPABASE_URL=
# Supabase secret key (sb_secret_…). Bypasses RLS: the orders table is closed to everything else.
SUPABASE_SECRET_KEY=
# Signs in to /admin. At least 24 characters: openssl rand -hex 24
ADMIN_TOKEN=
# Shipping-confirmation mail via Resend, from the verified groovedrinks.com domain.
RESEND_API_KEY=
ORDERS_EMAIL_FROM=Groove <orders@groovedrinks.com>

# ---- Behaviour analytics (PostHog) ----
# Project key (phc_…) and ingest host (https://us.i.posthog.com). Both are public by
# design: the key ships in the page. Read by the browser, by next.config.ts (the
# /ingest proxy) and by the Stripe webhook (the order_paid event). Leave both empty and
# nothing is recorded: set them in Production only, so local runs and previews stay out
# of the numbers.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
